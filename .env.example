ZOHO_DC=com
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REDIRECT_URI=http://localhost:3000/oauth/callback
# Deployments only (Coolify etc.) — leave blank locally, where token.json is used.
# Get the value with: npm run show-refresh-token
ZOHO_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_SHEET_RESOURCE_ID=your_sheet_resource_id
ZOHO_WORKSHEET_NAME=All
HISTORIC_DAYS=30
ZOHO_FETCH_TAGGED=true
ZOHO_FULL_SYNC=true
ZOHO_MAIL_TAG=paypal-parsed
MAIL_SEARCH_KEY=sender:service@paypal.com
PAYPAL_SENDER=service@paypal.com
POLL_INTERVAL_SECONDS=300
TOKEN_PATH=token.json
